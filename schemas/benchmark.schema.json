{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gashasbi/evidencelab/schemas/benchmark.schema.json",
  "title": "EvidenceLab Benchmark 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dataset": {
      "type": "object"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "split": {
      "type": "object"
    },
    "allow_duplicate_graphs": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "graph",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "graph": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "enum": [
              "MATCH",
              "NO_MATCH",
              "UNKNOWN"
            ]
          },
          "partition": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mutation_of": {
            "type": "string"
          },
          "changed_dimension": {
            "type": "string"
          },
          "expected_relation": {
            "enum": [
              "flip",
              "same",
              "indeterminate"
            ]
          },
          "dataset": {
            "type": "object"
          },
          "capture": {
            "type": "object"
          },
          "scope": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          },
          "label_provenance": {
            "type": "object"
          },
          "case_identity": {
            "type": "object"
          },
          "source_sha256": {
            "type": "string"
          },
          "source_content_sha256": {
            "type": "string"
          },
          "normalized_source_hash": {
            "type": "string"
          },
          "pair_id": {
            "type": "string"
          },
          "counterpart": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "capture_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
