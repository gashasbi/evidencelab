{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gashasbi/evidencelab/schemas/provenance.schema.json",
  "title": "EvidenceLab Provenance 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "root": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "activity",
          "agent",
          "inputs",
          "outputs",
          "parameters",
          "timestamp_utc",
          "digest"
        ]
      }
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
