{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gashasbi/evidencelab/schemas/research-benchmark.schema.json",
  "title": "EvidenceLab Research Benchmark 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string"
    },
    "split": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "MATCH",
              "NO_MATCH",
              "UNKNOWN"
            ]
          },
          "graph": {
            "type": "string"
          },
          "partition": {
            "type": "string"
          },
          "label_provenance": {
            "type": "object"
          },
          "case_identity": {
            "type": "object"
          },
          "dataset": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
