{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gashasbi/evidencelab/schemas/experiment.schema.json",
  "title": "EvidenceLab Experiment 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "timestamp_utc",
    "hypothesis",
    "tool",
    "command",
    "result",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "experiment_id": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "result": {},
    "cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "previous": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
