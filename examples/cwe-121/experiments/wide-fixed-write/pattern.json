  "cwe": "CWE-121",
  "name": "Wide-character element-count write beyond an automatic local array",
  "version": "1.0.0",
  "language": "C/C++",
  "description": "Experimental evidence family for wide-character writes where a proven element count exceeds an automatic local array's proven element capacity. Element counts are never compared to byte capacity. A MATCH is an evidence-pattern match, not a claim of exploitability or physical stack placement. This experiment has not yet passed the required independent benchmark quality gates and is not an official research benchmark family.",
  "unknown_policy": "unknown",
  "counter_unknown_policy": "ignore",
