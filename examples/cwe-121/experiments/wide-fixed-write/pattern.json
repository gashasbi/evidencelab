      "source": "source",
      "target": "destination",
      "relation": "DATA_FLOW",
      "max_hops": 12,
      "description": "The input reaches the destination through semantic data flow."
    },
    {
      "id": "C8",
      "required": true,
      "kind": "edge",
      "source": "destination",
      "target": "target",
      "direction": "either",
      "edge_types": [
        "REF"
      ],
      "allow_call_binding": true,
      "description": "Destination resolves to the target object through a direct reference or a verified call-site argument binding."
    },
    {
      "id": "C9",
      "kind": "property",
      "required": true,
      "slot": "target",
      "equals": {
        "derived.storage_duration": "AUTOMATIC"
      },
      "description": "Target storage duration is automatic."
    },
    {
      "id": "C10",
      "kind": "property",
      "required": true,
      "slot": "target",
      "equals": {
        "derived.is_array": true
      },
      "description": "Target is an array."
    },
    {
      "id": "C11",
      "kind": "property",
      "required": true,
      "slot": "extent",
      "properties_present": [
