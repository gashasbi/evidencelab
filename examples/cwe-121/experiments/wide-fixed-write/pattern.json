    "scope": "C/C++ + Joern",
    "physical_stack_note": "Automatic storage duration is proven from CPG LOCAL semantics; physical stack residency remains UNKNOWN.",
    "evidence_class": "EXPERIMENTAL_UNVALIDATED",
    "analyzer_scope": "Joern observations normalized through EvidenceLab canonical semantic layer",
