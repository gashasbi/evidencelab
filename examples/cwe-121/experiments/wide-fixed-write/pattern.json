      ],
      "description": "The extent has deterministic numeric evidence."
    },
    {
      "id": "C12",
      "kind": "compare",
      "required": true,
      "left": {
        "slot": "extent",
        "property": "derived.numeric_value"
      },
      "operator": ">",
      "right": {
        "slot": "target",
        "property": "derived.memory_capacity_elements"
      },
      "description": "The proven wide-character element count exceeds the proven target element capacity."
    },
    {
      "id": "C13",
      "kind": "edge",
      "required": true,
      "source": "sink",
      "target": "extent",
      "edge_types": [
        "ARGUMENT"
      ],
      "description": "The numeric extent expression is passed to the bounded-write sink."
    },
    {
      "id": "C14",
      "kind": "property",
      "required": true,
      "slot": "extent",
      "equals": {
        "derived.argument_index": 3
      },
      "description": "The bound extent is specifically the third CPG argument (the write-size argument for memcpy/memmove)."
    },
    {
      "id": "C15",
      "kind": "property",
      "required": true,
      "slot": "destination",
      "equals": {
        "derived.argument_index": 1
      },
      "description": "The destination expression is the first CPG argument of the bounded-write sink."
    },
    {
      "id": "C16",
      "kind": "semantic",
      "required": true,
      "slot": "sink",
      "equals": {
        "derived.wide_fixed_extent_write_like": true
      },
      "description": "Sink is a wide-character fixed-extent write."
    },
    {
      "id": "C18",
      "kind": "property",
      "required": true,
      "description": "Target capacity is explicitly measured in elements.",
      "slot": "target",
      "equals": {
        "derived.capacity_unit": "ELEMENTS"
      }
    },
    {
      "id": "C19",
      "kind": "property",
      "required": true,
      "description": "Target has array semantics; element capacity is derived from its array shape.",
      "slot": "target",
      "equals": {
        "derived.is_array": true
      }
    },
    {
      "id": "C17",
      "kind": "same_object",
      "required": true,
      "source": "destination",
      "target": "target",
      "description": "Destination and target resolve to the same memory object."
    },
    {
      "id": "C20",
      "kind": "property",
      "required": true,
      "slot": "sink",
      "equals": {
        "derived.write_extent_unit": "ELEMENTS"
      },
      "description": "The sink's extent argument is explicitly measured in elements."
