      "id": "C10",
      "kind": "semantic",
      "required": true,
      "slot": "target"
    },
    {
      "description": "Capacity and copy extent use byte units.",
      "equals": {
        "derived.capacity_unit": "BYTES"
      },
      "id": "C11",
      "kind": "semantic",
      "required": true,
      "slot": "target"
    },
    {
      "description": "Capacity has explicit derivation provenance.",
      "id": "C12",
      "kind": "property",
      "properties_present": [
        "derived.capacity_proof"
      ],
      "required": true,
      "slot": "target"
    },
    {
      "description": "Storage region is explicitly modeled.",
      "id": "C13",
      "kind": "property",
      "properties_present": [
        "derived.memory_region"
      ],
      "required": true,
      "slot": "target"
    },
    {
      "description": "The source expression is bound.",
      "id": "C14",
      "kind": "node",
      "required": true,
      "slot": "source"
    },
    {
      "description": "Source is represented as a concrete value expression.",
      "equals": {
        "derived.node_kind": "IDENTIFIER"
      },
      "id": "C15",
      "kind": "semantic",
      "required": true,
      "slot": "source"
    },
    {
      "description": "Source value reaches the destination within the same witness.",
      "id": "C16",
      "kind": "relation",
      "max_hops": 24,
      "relation": "DATA_FLOW",
      "required": true,
      "source": "source",
      "target": "destination"
    },
    {
      "description": "The sink is a formatted output operation.",
      "equals": {
        "derived.format_write_like": true
      },
      "id": "C17",
      "kind": "semantic",
      "required": true,
      "slot": "sink"
    },
    {
      "description": "The formatted write is unbounded with respect to destination size.",
      "equals": {
        "derived.unbounded_write_like": true
      },
      "id": "C18",
      "kind": "semantic",
      "required": true,
      "slot": "sink"
    },
    {
      "description": "No destination-size bound is encoded in the sink semantics.",
      "equals": {
        "derived.write_extent_mode": "UNBOUNDED"
      },
      "id": "C19",
      "kind": "semantic",
      "required": true,
      "slot": "sink"
    },
    {
      "any_of": {
        "derived.memory_region": [
          "AUTOMATIC",
          "STATIC",
          "HEAP",
          "LOCAL_OR_GLOBAL"
        ]
      },
      "description": "The target region is within the supported storage scope.",
      "id": "C20",
      "kind": "property",
      "required": true,
      "slot": "target"
    }
