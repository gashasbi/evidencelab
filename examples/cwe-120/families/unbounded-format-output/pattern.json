      "max_hops": 3,
      "relation": "REFERENCE",
      "required": true,
      "source": "destination",
      "target": "target"
    },
    {
      "description": "Destination and target are proven to denote the same object.",
      "id": "C08",
      "kind": "same_object",
      "required": true,
